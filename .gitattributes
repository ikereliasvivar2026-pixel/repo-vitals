# Force LF on checkout for every text file so prettier's `endOfLine: lf` rule
# stays green on Windows runners (git on Windows would otherwise convert to CRLF).
* text=auto eol=lf

# Common text source files — explicit declaration helps editors that don't honor
# the catch-all rule above.
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.cjs       text eol=lf
*.mjs       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf
*.html      text eol=lf
*.css       text eol=lf

# Binaries — never normalize.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.svg       text eol=lf
