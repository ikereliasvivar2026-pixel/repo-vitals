{
  "name": "repo-vitals",
  "version": "0.1.0",
  "description": "Lighthouse for your open-source repos. Score your repo's health against best practices and get actionable fixes. Works as CLI, GitHub Action, and badge.",
  "keywords": [
    "open-source",
    "github",
    "repo-health",
    "best-practices",
    "linter",
    "audit",
    "cli",
    "community-standards",
    "github-action",
    "developer-tools",
    "devtools",
    "code-quality",
    "readme",
    "license",
    "checklist",
    "lighthouse",
    "score",
    "badge",
    "oss"
  ],
  "author": "ikereliasvivar2026-pixel",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "repo-vitals": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikereliasvivar2026-pixel/repo-vitals.git"
  },
  "bugs": {
    "url": "https://github.com/ikereliasvivar2026-pixel/repo-vitals/issues"
  },
  "homepage": "https://github.com/ikereliasvivar2026-pixel/repo-vitals#readme",
  "publishConfig": {
    "access": "public"
  }
}
